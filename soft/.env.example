NEXUS_SECRET_KEY=replace-with-a-long-random-value
NEXUS_DATA_DIR=data
# Optional overrides:
# NEXUS_DATABASE=data/nexus.sqlite3
# NEXUS_UPLOAD_DIR=data/uploads
# Email notifications:
# NEXUS_NOTIFICATION_EMAIL=you@example.com
# NEXUS_SMTP_HOST=smtp.example.com
# NEXUS_SMTP_PORT=587
# NEXUS_SMTP_USERNAME=your-smtp-username
# NEXUS_SMTP_PASSWORD=your-smtp-password
# NEXUS_SMTP_FROM=website@example.com
# NEXUS_SMTP_USE_TLS=true
# NEXUS_SMTP_USE_SSL=false
